{
  "manifest_version": 2,
  "name": "OLED Black Theme",
  "version": "1.0.0",
  "description": "Pure black Firefox frame, tabs, toolbar and menus for OLED displays.",
  "browser_specific_settings": { "gecko": { "id": "oled-black-theme@nggkroze" } },
  "theme": {
    "colors": {
      "frame": "#000000",
      "frame_inactive": "#000000",
      "tab_background_text": "#aaaaaa",
      "tab_selected": "#111111",
      "tab_text": "#ffffff",
      "tab_line": "#444444",
      "toolbar": "#000000",
      "toolbar_text": "#e6e6e6",
      "toolbar_top_separator": "#000000",
      "toolbar_bottom_separator": "#1a1a1a",
      "toolbar_field": "#121212",
      "toolbar_field_text": "#ffffff",
      "toolbar_field_border": "#222222",
      "toolbar_field_focus": "#000000",
      "toolbar_field_text_focus": "#ffffff",
      "toolbar_field_border_focus": "#555555",
      "popup": "#000000",
      "popup_text": "#e6e6e6",
      "popup_border": "#333333",
      "popup_highlight": "#1a1a1a",
      "popup_highlight_text": "#ffffff",
      "sidebar": "#000000",
      "sidebar_text": "#e6e6e6",
      "sidebar_border": "#1a1a1a",
      "ntp_background": "#000000",
      "ntp_text": "#ffffff",
      "button_background_hover": "#1a1a1a",
      "button_background_active": "#2a2a2a",
      "icons": "#e6e6e6"
    },
    "properties": { "color_scheme": "dark", "content_color_scheme": "dark" }
  }
}
